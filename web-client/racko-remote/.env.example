# Dev defaults (also used when these are unset).
VITE_GATEWAY_URL=ws://localhost:7171/jet/rdp
VITE_BROKER_API_BASE=http://localhost:9090
# Mode B signaling (standalone modeb_webrtc_probe until the main broker serves it).
VITE_MODEB_SIGNALING_URL=ws://localhost:8080/webrtc

# Optional dev prefill for the connect form (put real values in .env.local, never here).
# There is deliberately no password variable: VITE_* values are baked into the bundle.
# VITE_DEV_RDP_HOST=rdp.example.com:3389
# VITE_DEV_RDP_USER=Administrator

# Production, behind nginx:
# VITE_GATEWAY_URL=wss://<domain>/ws
# VITE_BROKER_API_BASE=https://<domain>/api
