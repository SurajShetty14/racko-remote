# WebSocket listen address. The browser client uses ws://localhost:7171/jet/rdp
BIND_ADDR=0.0.0.0:7171

# Session list, kill, health, and Prometheus metrics.
MANAGEMENT_ADDR=0.0.0.0:9090

# Allowed RDP endpoints for both modes: RDP_TARGET plus the optional comma-separated
# RDP_ALLOWED_TARGETS. The login form Hostname must match one of them as host:port.
# The Mode B probes connect to RDP_TARGET.
RDP_TARGET=203.0.113.10:3389
# RDP_ALLOWED_TARGETS=203.0.113.11:3389,203.0.113.12:3389

# Mode B signs in with the username/password the browser sends for each session.
# Optional fallback: when a browser sends an empty username and password, the broker signs in
# with these instead. Leave them unset to require per-session credentials.
# The Mode B probes (modeb_probe, modeb_encode_probe, modeb_webrtc_probe) still require them.
# RDP_USERNAME=
# RDP_PASSWORD=
# Optional Active Directory / NetBIOS domain for the fallback.
# RDP_DOMAIN=

# insecure: accept the server's self-signed RDP certificate (typical for a lab VM).
# strict: validate the certificate against the OS trust store.
RDP_TLS_VERIFY=insecure

# Close a session after this many seconds with no bytes in either direction.
# 0 disables the idle timeout.
IDLE_TIMEOUT_SECS=900

# Mode B in the main broker (built with --features modeb-encode): WebRTC signaling at
# ws://<MANAGEMENT_ADDR>/modeb/webrtc?dest=host:port. Defaults shown.
# MODEB_MAX_SESSIONS: concurrent Mode B sessions; keep at or below the GPU's NVENC session limit (~5-8 on GeForce).
# MODEB_MAX_SESSIONS=5

# Mode B STUN/TURN (required for Mode B): a Cloudflare TURN key (Dashboard > Realtime > TURN).
# The broker mints fresh credentials per session and sends them to the browser; the token stays here.
# Without these, or if minting fails at startup, Mode B is disabled and Mode C keeps running.
# TURN_KEY_ID=<Cloudflare TURN key ID>
# TURN_API_TOKEN=<that key's API token>
# Lifetime of each session's minted credentials, 60-172800 seconds. Default shown.
# TURN_CREDENTIAL_TTL_SECS=3600

# Mode B desktop size. Broker sessions use the browser's screen size (capped at 1920x1200)
# and fall back to this when the browser sends none (default 1920x1080).
# The probes always use it (default 1280x1024).
# MODEB_DESKTOP_WIDTH=1920
# MODEB_DESKTOP_HEIGHT=1080

# Mode B Phase 1 framebuffer dump (PNG proof of decode). Defaults shown.
# MODEB_FRAME_PATH=/tmp/modeb-frame.png
# MODEB_DUMP_INTERVAL_SECS=2

# Mode B H.264 encoder (MP4 and WebRTC probes). Defaults shown.
# MODEB_FPS: capture/encode rate, 1-60 (legacy name MODEB_ENCODE_FPS still read).
# MODEB_RC_MODE: nvh264enc rate control: cbr | cbr-ld-hq | cbr-hq | vbr | vbr-hq (VBR peaks at 1.5x bitrate).
# MODEB_FPS=30
# MODEB_BITRATE_KBPS=12000
# MODEB_RC_MODE=cbr

# Mode B Phase 2 MP4 proof. Defaults shown.
# MODEB_ENCODE_PATH=/tmp/modeb-encoded.mp4
# MODEB_ENCODE_DURATION_SECS=10

# Deprecated Mode B WebRTC probe: test page + signaling (http://<bind>/modeb.html, ws://<bind>/webrtc).
# Defaults shown.
# MODEB_WEBRTC_BIND=127.0.0.1:8080
