# WebSocket listen address. The browser client uses ws://localhost:7171/jet/rdp
BIND_ADDR=0.0.0.0:7171

# Session list, kill, health, and Prometheus metrics.
MANAGEMENT_ADDR=0.0.0.0:9090

# Only this RDP endpoint is accepted. The login form Hostname must match host:port.
RDP_TARGET=203.0.113.10:3389

# insecure: accept the server's self-signed RDP certificate (typical for a lab VM).
# strict: validate the certificate against the OS trust store.
RDP_TLS_VERIFY=insecure

# Close a session after this many seconds with no bytes in either direction.
# 0 disables the idle timeout.
IDLE_TIMEOUT_SECS=900
